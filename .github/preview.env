# FE PR previews (see .github/workflows/fe-preview-*.yml). Read from the base branch only.
#
# Off switch: previews build and deploy only when this is true. Flip it after the one-time setup.
PREVIEW_ENABLED=true
# Previews are served at https://<PR number>.<PREVIEW_DOMAIN>.
PREVIEW_DOMAIN=preview.groups.zedu.chat
# Backend for previews without a `Backend URL:` override in the PR body: the live backend, so a
# reviewer can reproduce a ticket against the same data. Review with a test account, not a real one.
PREVIEW_BACKEND_HOST=api.zedu.chat
#
# Public build values, copied from zedu-hng-fe (hng.groups.zedu.chat). NEXT_PUBLIC_* values ship in
# the browser bundle, so nothing here is secret. API_URL, BASE_URL, CONNECT_URL and CLIENT_URL are
# derived per preview from the backend host and the preview URL. Analytics, push, webhooks and Agora
# stay unset, as on zedu-hng-fe. Never add a secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=764182056638-bi8bet0rdoabaeq24bqsdnb5iukn7ko4.apps.googleusercontent.com
NEXT_PUBLIC_OFFICE_EMBED_URL=https://view.officeapps.live.com/op/embed.aspx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKwnwddbS-Ip4gOGxlgLIq8IG2PBtITD_XTfQHiplNUA0SyBYxVr1LrakFhKbDoL2J7iADZlxI51X9JkqiM3ze0
